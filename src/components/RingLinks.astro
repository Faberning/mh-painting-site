---
// Links from a geo-lever page out to its live GBP post and YouTube video.
// Renders nothing until ring.ts has a live entry for the page.
import { RING } from "../ring";
interface Props { path: string }
const { path } = Astro.props;
const r = RING[path] ?? {};
const items = [
  r.gbpPost && { href: r.gbpPost, label: "Our Google Business Profile post on this" },
  r.youtubeId && { href: `https://www.youtube.com/watch?v=${r.youtubeId}`, label: "Watch the video on YouTube" },
].filter(Boolean) as { href: string; label: string }[];
---
{items.length > 0 && (
  <p class="ring-links">
    Also from mh painting:{" "}
    {items.map((it, i) => (
      <>{i > 0 && " · "}<a href={it.href} rel="noopener" target="_blank">{it.label}</a></>
    ))}
  </p>
)}
<style>
  .ring-links { margin-top: 18px; font-size: 15px; color: var(--inkSoft); }
  .ring-links a { color: var(--accentDeep); }
</style>
